# Server-only Firebase Admin credentials for local Edge Function development.
# Never copy these values into root .env.local or any VITE_* variable.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="your-private-key-with-escaped-newlines"
PERCENT_USERNAME_AUTH_ENABLED=false
PERCENT_AUTH_EMAIL_ENABLED=false
PERCENT_USERNAME_RATE_LIMIT_SECRET=replace-with-a-long-random-server-secret
RESEND_API_KEY=replace-with-resend-api-key
PERCENT_AUTH_EMAIL_FROM="Percent <accounts@your-verified-domain>"
PERCENT_AUTH_APP_URL=https://your-percent-app.example
